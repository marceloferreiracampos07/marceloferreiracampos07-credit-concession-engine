generator client {
  provider = "prisma-client-js"
  // output aponta para node_modules/@prisma/client (padrão).
  // Altere para um caminho relativo se precisar de geração customizada.
}

datasource db {
  // No Prisma 7, "url" foi removido daqui.
  // A URL é injetada via prisma.config.ts na raiz do projeto.
  provider = "postgresql"
}

model Fundo {
  id        String   @id @default(uuid())
  tenantId  String   @unique
  balance   Int
  updatedAt DateTime @updatedAt

  @@map("fundos")
}

model Contrato {
  id        String   @id @default(uuid())
  tenantId  String
  amount    Int
  status    String
  createdAt DateTime @default(now())

  @@map("contratos")
}
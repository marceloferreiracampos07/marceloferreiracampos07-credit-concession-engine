generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model OutboxEvent {
  id            String   @id @default(uuid())
  aggregateType String
  eventType     String
  tenantUrl     String
  tenantFormat  String
  payload       Json
  status        String   @default("PENDING")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("outbox_events")
}


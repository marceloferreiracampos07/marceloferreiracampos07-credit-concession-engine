// Este é um rascunho do Prisma Schema para a tabela de Outbox.
// Ele deve ficar na pasta prisma/ para que possamos rodar os testes de integração com banco real.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" // Supondo postgresql
  url      = env("DATABASE_URL")
}

model OutboxEvent {
  id            String   @id @default(uuid())
  aggregateType String
  eventType     String
  tenantUrl     String
  tenantFormat  String
  payload       Json
  status        String   @default("PENDING") // PENDING, PROCESSED, FAILED
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("outbox_events")
}
